---
import Layout from '../layouts/Layout.astro';

export interface Props {
  title: string;
  description: string;
  keywords?: string;
  schemaType?: 'article' | 'faq';
  datePublished?: string;
  dateModified?: string;
  readTime?: string;
  image?: string;
  canonical?: string;
  breadcrumbItems?: Array<{ name: string; url: string }>;
}

const {
  title,
  description,
  keywords,
  schemaType = 'article',
  datePublished = '2026-04-10',
  dateModified = '2026-04-11',
  readTime = '10 min read',
  image = '/og-image.svg',
  canonical,
  breadcrumbItems
} = Astro.props;

const siteUrl = 'https://policy-lens-ai-app.vercel.app';

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "author": {
    "@type": "Organization",
    "name": "PolicyLens"
  },
  "publisher": {
    "@type": "Organization",
    "name": "PolicyLens",
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/favicon.svg`
    }
  },
  "datePublished": datePublished,
  "dateModified": dateModified,
  "image": `${siteUrl}${image}`,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonical || `${siteUrl}${Astro.url.pathname}`
  }
};

const breadcrumbSchema = breadcrumbItems ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    ...breadcrumbItems.map((item, i) => ({
      "@type": "ListItem",
      "position": i + 2,
      "name": item.name,
      "item": `${siteUrl}${item.url}`
    }))
  ]
} : null;
---

<Layout title={title} description={description} keywords={keywords} schemaType={schemaType} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} slot="head" />
  {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />}
  <meta property="article:published_time" content={datePublished} slot="head" />
  <meta property="article:modified_time" content={dateModified} slot="head" />
  <slot name="head" />
  
  <article class="content-page">
    <div class="container">
      <div class="breadcrumbs">
        <a href="/">Home</a>
        <span>/</span>
        <slot name="breadcrumb" />
        <span>/</span>
        <span>{title}</span>
      </div>
      
      <header class="page-header">
        <h1>{title}</h1>
        <p class="page-description">{description}</p>
        <div class="page-meta">
          <span class="read-time">{readTime}</span>
          <span class="updated">Updated {new Date(dateModified).toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}</span>
        </div>
        <div class="share-bar">
          <span class="share-label">Share:</span>
          <button class="share-btn" data-platform="twitter" title="Share on X/Twitter">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </button>
          <button class="share-btn" data-platform="facebook" title="Share on Facebook">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </button>
          <button class="share-btn" data-platform="linkedin" title="Share on LinkedIn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </button>
          <button class="share-btn" data-platform="reddit" title="Share on Reddit">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.542 13.62c.167.167.262.387.262.62 0 .233-.095.453-.262.62-.167.167-.387.262-.62.262-.233 0-.453-.095-.62-.262-.167-.167-.262-.387-.262-.62 0-.233.095-.453.262-.62.167-.167.387-.262.62-.262.233 0 .453.095.62.262zm-11.084 0c.167.167.262.387.262.62 0 .233-.095.453-.262.62-.167.167-.387.262-.62.262-.233 0-.453-.095-.62-.262-.167-.167-.262-.387-.262-.62 0-.233.095-.453.262-.62.167-.167.387-.262.62-.262.233 0 .453.095.62.262zm2.969-5.508c.35-.13.733-.052 1.024.167.29.22.46.553.46.908 0 .233-.09.554-.3.778C9.558 10.71 8.296 11.2 7 11.2c-1.296 0-2.558-.49-3.61-1.235-.21-.224-.3-.545-.3-.778 0-.355.17-.689.46-.908.29-.22.674-.297 1.024-.167.35.13.656.357.878.653.55-.265 1.184-.414 1.836-.382L8.1 5.237c.06-.35.24-.66.508-.86.268-.2.6-.28.927-.22l2.634.537c.068-.04.142-.07.22-.09.078-.02.15-.03.222-.03.233 0 .453.095.62.262.167.167.262.387.262.62 0 .233-.095.453-.262.62-.167.167-.387.262-.62.262-.233 0-.453-.095-.62-.262-.167-.167-.262-.387-.262-.62 0-.02 0-.04.002-.06l-2.194-.446-.623 2.858c.652-.032 1.286.117 1.836.382.222-.296.528-.523.878-.653zM12 18.4c-1.335 0-2.73-.437-3.817-1.143-.217-.14-.34-.407-.34-.686 0-.28.123-.548.34-.688.217-.14.507-.173.76-.09.253.082.453.26.557.493.105.233.1.503-.017.73.35.253.832.404 1.517.474v-2.01c-.75-.112-1.45-.35-2.05-.703-.125-.073-.267-.11-.41-.11-.233 0-.453.095-.62.262-.167.167-.262.387-.262.62 0 .233.095.453.262.62.167.167.387.262.62.262.08 0 .158-.015.232-.043.79.493 1.727.772 2.248.878v.57c-.09.01-.18.015-.27.015-.35 0-.69-.14-.94-.392-.25-.252-.39-.592-.39-.948 0-.355.14-.696.39-.947.25-.252.59-.393.94-.393.35 0 .69.14.94.392.25.252.39.592.39.948 0 .356-.14.696-.39.948-.25.252-.59.392-.94.392-.09 0-.18-.005-.27-.015v-.57c.52-.106 1.458-.385 2.248-.878.074.028.152.043.232.043.233 0 .453-.095.62-.262.167-.167.262-.387.262-.62 0-.233-.095-.453-.262-.62-.167-.167-.387-.262-.62-.262-.143 0-.285.037-.41.11-.6.353-1.3.59-2.05.703v2.01c.685-.07 1.167-.22 1.517-.474-.117-.227-.122-.497-.017-.73.104-.233.304-.41.557-.493.253-.082.543-.05.76.09.217.14.34.408.34.688 0 .28-.123.546-.34.686-1.087.706-2.482 1.143-3.817 1.143z"/></svg>
          </button>
          <button class="share-btn" data-platform="copy" title="Copy link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          </button>
          <span class="share-copied hidden" id="share-copied">Copied!</span>
        </div>
      </header>
      
      <div class="content-wrapper">
        <aside class="toc-sidebar">
          <h3>Table of Contents</h3>
          <nav class="toc">
            <slot name="toc" />
          </nav>
        </aside>
        
        <div class="content-body">
          <slot />
        </div>
      </div>
      
      <section class="cta-section">
        <h2>Ready to Check a Privacy Policy?</h2>
        <p>Use our free AI-powered analyzer to see what's in any privacy policy.</p>
        <a href="/" class="btn btn-primary">Analyze a Policy Free</a>
      </section>
      
      <section class="related-content">
        <h3>Related Resources</h3>
        <div class="related-grid">
          <slot name="related" />
        </div>
      </section>
    </div>
  </article>
</Layout>

<style>
  .content-page {
    padding: 40px 0 80px;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 32px;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .breadcrumbs a {
    color: var(--accent-cyan);
  }

  .page-header {
    margin-bottom: 48px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--border-color);
  }

  .page-header h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    margin-bottom: 16px;
    line-height: 1.2;
  }

  .page-description {
    font-size: 1.25rem;
    color: var(--text-secondary);
    max-width: 700px;
    line-height: 1.6;
    margin-bottom: 16px;
  }

  .page-meta {
    display: flex;
    gap: 16px;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .content-wrapper {
    display: grid;
    grid-template-columns: 250px 1fr;
    gap: 48px;
  }

  .toc-sidebar {
    position: sticky;
    top: 100px;
    height: fit-content;
  }

  .toc-sidebar h3 {
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 16px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-muted);
  }

  .toc {
    font-size: 0.9rem;
  }

  .toc :global(a) {
    display: block;
    padding: 8px 0;
    color: var(--text-secondary);
    border-left: 2px solid transparent;
    padding-left: 12px;
    transition: all 0.2s ease;
  }

  .toc :global(a:hover) {
    color: var(--accent-cyan);
    border-left-color: var(--accent-cyan);
  }

  .content-body {
    max-width: 800px;
  }

  .content-body :global(h2) {
    font-size: 1.75rem;
    font-weight: 700;
    margin: 48px 0 24px;
    padding-top: 24px;
  }

  .content-body :global(h3) {
    font-size: 1.3rem;
    font-weight: 600;
    margin: 32px 0 16px;
  }

  .content-body :global(h4) {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 24px 0 12px;
  }

  .content-body :global(p) {
    color: var(--text-secondary);
    line-height: 1.8;
    margin-bottom: 16px;
  }

  .content-body :global(ul), .content-body :global(ol) {
    margin: 16px 0 24px 24px;
    color: var(--text-secondary);
  }

  .content-body :global(li) {
    margin-bottom: 8px;
    line-height: 1.7;
  }

  .content-body :global(.highlight-box) {
    background: rgba(0, 212, 255, 0.1);
    border: 1px solid rgba(0, 212, 255, 0.3);
    border-radius: var(--radius-md);
    padding: 20px;
    margin: 24px 0;
  }

  .content-body :global(.warning-box) {
    background: rgba(251, 191, 36, 0.1);
    border: 1px solid rgba(251, 191, 36, 0.3);
    border-radius: var(--radius-md);
    padding: 20px;
    margin: 24px 0;
  }

  .content-body :global(.checklist) {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 24px;
    margin: 24px 0;
  }

  .cta-section {
    text-align: center;
    padding: 64px 24px;
    background: var(--bg-secondary);
    border-radius: var(--radius-xl);
    margin: 64px 0;
  }

  .cta-section h2 {
    font-size: 1.75rem;
    margin-bottom: 12px;
  }

  .cta-section p {
    color: var(--text-secondary);
    margin-bottom: 24px;
  }

  .related-content {
    margin-top: 64px;
  }

  .related-content h3 {
    font-size: 1.25rem;
    margin-bottom: 24px;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
  }

  .share-bar {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: 20px;
    flex-wrap: wrap;
  }

  .share-label {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-right: 4px;
  }

  .share-btn {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .share-btn:hover {
    color: var(--accent-cyan);
    border-color: var(--accent-cyan);
    background: rgba(0, 212, 255, 0.1);
  }

  .share-copied {
    font-size: 0.8rem;
    color: #22c55e;
    font-weight: 600;
    margin-left: 8px;
    animation: fadeIn 0.3s ease;
  }

  .share-copied.hidden {
    display: none;
  }

  @media (max-width: 900px) {
    .content-wrapper {
      grid-template-columns: 1fr;
    }

    .toc-sidebar {
      position: static;
      display: none;
    }
  }
</style>

<script>
  const shareBar = document.querySelector('.share-bar');
  if (shareBar) {
    shareBar.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.share-btn') as HTMLButtonElement;
      if (!btn) return;
      
      const platform = btn.dataset.platform;
      const url = encodeURIComponent(window.location.href);
      const text = encodeURIComponent(document.title);
      
      let shareUrl = '';
      switch (platform) {
        case 'twitter':
          shareUrl = `https://twitter.com/intent/tweet?url=${url}&text=${text}&via=policylens`;
          break;
        case 'facebook':
          shareUrl = `https://www.facebook.com/sharer/sharer.php?u=${url}`;
          break;
        case 'linkedin':
          shareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${url}`;
          break;
        case 'reddit':
          shareUrl = `https://www.reddit.com/submit?url=${url}&title=${text}`;
          break;
        case 'copy':
          navigator.clipboard.writeText(window.location.href).then(() => {
            const copied = document.getElementById('share-copied');
            if (copied) {
              copied.classList.remove('hidden');
              setTimeout(() => copied.classList.add('hidden'), 2000);
            }
          });
          return;
      }
      
      if (shareUrl) {
        window.open(shareUrl, '_blank', 'width=600,height=400');
      }
    });
  }
</script>
