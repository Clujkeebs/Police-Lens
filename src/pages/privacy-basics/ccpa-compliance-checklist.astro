    list-style: none;
  }

  .toc-sidebar li {
    margin-bottom: 8px;
  }

  .toc-sidebar a {
    color: var(--text-secondary);
    font-size: 0.9rem;
    display: block;
    padding: 6px 0;
    transition: color 0.2s;
  }

  .toc-sidebar a:hover {
    color: var(--accent-cyan);
  }

  .article-content {
    max-width: 800px;
  }

  .article-content section {
    margin-bottom: 48px;
  }

  .article-content h2 {
    font-size: 1.75rem;
    font-weight: 700;
    margin: 48px 0 24px;
    padding-top: 24px;
    border-top: 1px solid var(--border-color);
  }

  .article-content h2:first-child {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  .article-content h3 {
    font-size: 1.2rem;
    font-weight: 600;
    margin: 32px 0 16px;
  }

  .article-content p {
    color: var(--text-secondary);
    line-height: 1.8;
    margin-bottom: 16px;
  }

  .article-content ul {
    color: var(--text-secondary);
    margin: 16px 0 24px 24px;
  }

  .article-content li {
    margin-bottom: 8px;
    line-height: 1.7;
  }

  .highlight-box, .warning-box, .checklist-section {
    background: var(--bg-card);
    border-radius: var(--radius-lg);
    padding: 24px;
    margin: 24px 0;
  }

  .highlight-box {
    background: rgba(0, 212, 255, 0.1);
    border: 1px solid rgba(0, 212, 255, 0.3);
  }

  .warning-box {
    background: rgba(251, 191, 36, 0.1);
    border: 1px solid rgba(251, 191, 36, 0.3);
  }

  .highlight-box h3, .warning-box h3, .checklist-section h3 {
    margin-top: 0;
