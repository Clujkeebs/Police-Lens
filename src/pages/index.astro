---
import Layout from '../layouts/Layout.astro';
import PolicyAnalyzer from '../components/PolicyAnalyzer.astro';
---

<Layout
  title="Free Privacy Policy & Terms of Service Analyzer"
  description="Instantly analyze privacy policies and terms of service. Get clear breakdowns of data collection, sharing practices, and your rights. Free, instant, no signup required."
>
  <section class="hero">
    <div class="hero-content">
      <h1 class="hero-title">
        Understand What You're
        <span class="gradient-text">Actually Agreeing To</span>
      </h1>
      <p class="hero-subtitle">
        Stop scrolling past walls of legal text. PolicyLens breaks down privacy policies and terms of service into clear, actionable insights.
      </p>
      <div class="hero-stats">
        <div class="stat">
          <span class="stat-number">10,000+</span>
          <span class="stat-label">Policies Analyzed</span>
        </div>
        <div class="stat">
          <span class="stat-number">4.9</span>
          <span class="stat-label">User Rating</span>
        </div>
        <div class="stat">
          <span class="stat-number">100%</span>
          <span class="stat-label">Free Forever</span>
        </div>
      </div>
    </div>
  </section>

  <section class="analyzer-section">
    <PolicyAnalyzer />
  </section>

  <section class="features-section">
    <div class="container">
      <h2 class="section-title">How PolicyLens Protects You</h2>
      <p class="section-subtitle">Get instant clarity on what you're signing up for</p>
      
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <polyline points="9 12 11 14 15 10"/>
            </svg>
          </div>
          <h3>Data Collection Analysis</h3>
          <p>See exactly what information apps and services collect about you, from basic contact info to browsing habits and location data.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <line x1="2" y1="12" x2="22" y2="12"/>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
          </div>
          <h3>Third-Party Sharing</h3>
          <p>Find out who else gets access to your data - advertisers, partners, data brokers, and government agencies.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <h3>Your Rights Explained</h3>
          <p>Understand what control you have over your data - from deletion rights to opt-out options and data portability.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
              <line x1="12" y1="9" x2="12" y2="13"/>
              <line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
          </div>
          <h3>Red Flag Detection</h3>
          <p>We flag concerning clauses like unlimited liability, class action waivers, and vague data selling provisions.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
              <line x1="3" y1="9" x2="21" y2="9"/>
              <line x1="9" y1="21" x2="9" y2="9"/>
            </svg>
          </div>
          <h3>Side-by-Side Comparison</h3>
          <p>Compare multiple policies at once to make informed decisions about which service best respects your privacy.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
            </svg>
          </div>
          <h3>Compliance Check</h3>
          <p>See if policies mention GDPR, CCPA, HIPAA, and other privacy regulations that protect your rights.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="how-it-works">
    <div class="container">
      <h2 class="section-title">Simple as 1-2-3</h2>
      <p class="section-subtitle">Get instant analysis in seconds</p>
      
      <div class="steps">
        <div class="step">
          <div class="step-number">1</div>
          <h3>Paste or Enter</h3>
          <p>Paste the policy text directly or enter a URL to fetch it automatically.</p>
        </div>
        <div class="step-connector"></div>
        <div class="step">
          <div class="step-number">2</div>
          <h3>Instant Analysis</h3>
          <p>Our engine scans for key clauses, risk factors, and your rights in seconds.</p>
        </div>
        <div class="step-connector"></div>
        <div class="step">
          <div class="step-number">3</div>
          <h3>Get Clear Results</h3>
          <p>Receive a detailed breakdown with risk scores, red flags, and recommendations.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="popular-analysis">
    <div class="container">
      <h2 class="section-title">Popular Policy Analysis</h2>
      <p class="section-subtitle">See what we found in commonly used services</p>
      
      <div class="analysis-grid">
        <a href="/?url=https://www.facebook.com/legal/privacy" class="analysis-card">
          <div class="analysis-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </div>
          <div class="analysis-info">
            <h4>Facebook / Meta</h4>
            <span class="risk-tag high">High Risk</span>
          </div>
        </a>

        <a href="/?url=https://twitter.com/en/privacy" class="analysis-card">
          <div class="analysis-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </div>
          <div class="analysis-info">
            <h4>X / Twitter</h4>
            <span class="risk-tag medium">Medium Risk</span>
          </div>
        </a>

        <a href="/?url=https://policies.google.com/privacy" class="analysis-card">
          <div class="analysis-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
            </svg>
          </div>
          <div class="analysis-info">
            <h4>Google</h4>
            <span class="risk-tag medium">Medium Risk</span>
          </div>
        </a>

        <a href="/?url=https://www.amazon.com/privacy" class="analysis-card">
          <div class="analysis-icon">
