---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import ComparisonView from '../components/ComparisonView.astro';

const p1Param = Astro.url.searchParams.get('p1');
const p2Param = Astro.url.searchParams.get('p2');

let policy1 = null;
let policy2 = null;
let comparison = null;
let error = null;

if (p1Param && p2Param) {
  try {
    policy1 = JSON.parse(decodeURIComponent(p1Param));
    policy2 = JSON.parse(decodeURIComponent(p2Param));
    comparison = comparePolicyResults(policy1, policy2);
  } catch (e) {
    error = 'Could not load comparison data';
  }
} else {
  error = 'Missing comparison data';
}

interface CategoryResult {
  category?: string;
  matchCount: number;
  severity: string;
  matchedKeywords?: string[];
  findings?: string[];
}

interface PolicyResult {
  domain: string;
  url?: string;
  title: string;
  analysis?: {
    riskScore: number;
    riskLevel: string;
    categories?: Record<string, CategoryResult>;
    redFlags?: Array<{ message: string; severity: string }>;
    goodSigns?: Array<{ message: string }>;
    summary?: { overview: string; keyPoints: string[] };
  };
}

function comparePolicyResults(policy1: PolicyResult, policy2: PolicyResult) {
  const categories: Record<string, Record<string, { matchCount: number; severity: string } | null>> = {};
  const differences: Array<{ category: string; type: string; message: string }> = [];
  const similarities: string[] = [];

  const cats1 = Object.keys(policy1.analysis?.categories || {});
  const cats2 = Object.keys(policy2.analysis?.categories || {});
  const allCats = [...new Set([...cats1, ...cats2])];

  for (const cat of allCats) {
    const c1 = policy1.analysis?.categories?.[cat];
    const c2 = policy2.analysis?.categories?.[cat];
    categories[cat] = {
      [policy1.domain]: c1 ? { matchCount: c1.matchCount || 0, severity: c1.severity || 'info' } : null,
      [policy2.domain]: c2 ? { matchCount: c2.matchCount || 0, severity: c2.severity || 'info' } : null
    };
    if (c1 && c2 && c1.matchCount !== c2.matchCount) {
      differences.push({
        category: c1.category || cat,
        type: 'frequency',
        message: `${policy1.domain} has ${c1.matchCount > c2.matchCount ? 'more' : 'fewer'} mentions of "${c1.category || cat}" than ${policy2.domain}`
      });
    } else if (c1 && !c2) {
      differences.push({
        category: c1.category || cat,
        type: 'uniqueness',
        message: `${policy1.domain} addresses "${c1.category || cat}" while ${policy2.domain} does not`
      });
    } else if (!c1 && c2) {
      differences.push({
        category: c2.category || cat,
        type: 'uniqueness',
        message: `${policy2.domain} addresses "${c2.category || cat}" while ${policy1.domain} does not`
      });
    }
  }

  const score1 = policy1.analysis?.riskScore || 50;
  const score2 = policy2.analysis?.riskScore || 50;
  const winner = score1 <= score2 ? policy1.domain : policy2.domain;

  return {
    riskScores: { [policy1.domain]: score1, [policy2.domain]: score2 },
    riskLevels: { [policy1.domain]: policy1.analysis?.riskLevel || 'medium', [policy2.domain]: policy2.analysis?.riskLevel || 'medium' },
    categories,
    differences,
    similarities,
    summary: {
      winner,
      saferScore: Math.min(score1, score2),
      riskierScore: Math.max(score1, score2),
      recommendation: score1 === score2
        ? 'Both policies have similar risk profiles.'
        : `${winner} has a better privacy posture.`
    }
  };
}
---

<Layout
  title="Policy Comparison"
  description="Compare privacy policies side-by-side to make informed decisions about which services respect your privacy."
  noindex={true}
>
  <section class="compare-page">
    <div class="container">
      <div class="page-header">
        <a href="/" class="back-link">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="19" y1="12" x2="5" y2="12"/>
            <polyline points="12 19 5 12 12 5"/>
          </svg>
          New Analysis
        </a>
      </div>

      {error ? (
        <div class="error-state">
          <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
          <h1>{error}</h1>
          <p>Please analyze two policies and try the comparison feature again.</p>
          <a href="/" class="btn btn-primary">Start Fresh</a>
        </div>
      ) : (
        <ComparisonView comparison={comparison} policy1={policy1} policy2={policy2} />
      )}
    </div>
  </section>
</Layout>

<style>
  .compare-page {
    padding: 40px 24px 80px;
    min-height: calc(100vh - 200px);
  }

  .container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .page-header {
    margin-bottom: 32px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-secondary);
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--accent-cyan);
  }

  .error-state {
    text-align: center;
    padding: 80px 24px;
    max-width: 500px;
    margin: 0 auto;
  }

  .error-state svg {
    color: #ef4444;
    margin-bottom: 24px;
  }

  .error-state h1 {
    font-size: 1.5rem;
    margin-bottom: 12px;
  }

  .error-state p {
    color: var(--text-secondary);
    margin-bottom: 32px;
  }
</style>
