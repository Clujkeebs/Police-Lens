    padding: 2rem 1.5rem;
    font-family: var(--font-body, system-ui, sans-serif);
    color: var(--text-primary, #1a1a2e);
    background: var(--bg-primary, #ffffff);
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
